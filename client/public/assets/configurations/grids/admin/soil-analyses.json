{
  "name": "soilAnalyses.title",
  "dataKey": "id",
  "request": { "type": "GET", "api": "/api/admin/soil-analyses" },
  "save": { "type": "POST", "api": "/api/admin/soil-analyses" },
  "delete": { "type": "DELETE", "api": "/api/admin/soil-analyses/:id" },
  "dialogTitleCreate": "soilAnalyses.newAnalysis",
  "dialogTitleEdit": "soilAnalyses.editAnalysis",
  "dialogWidth": "40rem",
  "columns": [
    {
      "title": "",
      "field": "",
      "actions": [
        { "type": "emit", "key": "view-documents", "icon": "pi pi-paperclip", "title": "documents.title" },
        { "type": "edit", "icon": "pi pi-pencil", "title": "general.edit" },
        { "type": "delete", "icon": "pi pi-trash", "title": "general.delete" }
      ]
    },
    { "title": "soilAnalyses.sampleDate", "field": "sample_date", "type": "date" },
    { "title": "soilAnalyses.parcel", "field": "parcel_name", "type": "string" },
    {
      "title": "soilAnalyses.sampleType",
      "field": "sample_type",
      "type": "string",
      "translateMap": {
        "soil": "soilAnalyses.sampleType.soil",
        "leaf": "soilAnalyses.sampleType.leaf",
        "grape": "soilAnalyses.sampleType.grape"
      }
    },
    { "title": "soilAnalyses.labName", "field": "lab_name", "type": "string" },
    { "title": "soilAnalyses.ph", "field": "ph", "type": "number" }
  ],
  "fields": [
    {
      "type": "combobox",
      "name": "parcel_id",
      "title": "soilAnalyses.parcel",
      "width": "48%",
      "required": true,
      "request": { "type": "GET", "api": "/api/admin/vineyard-parcels" },
      "allowCreate": true,
      "createConfigFile": "vineyard-parcels.json"
    },
    { "type": "date", "name": "sample_date", "title": "soilAnalyses.sampleDate", "width": "48%", "required": true },
    {
      "type": "combobox",
      "name": "sample_type",
      "title": "soilAnalyses.sampleType",
      "width": "48%",
      "required": true,
      "options": [
        { "text": "soilAnalyses.sampleType.soil", "value": "soil" },
        { "text": "soilAnalyses.sampleType.leaf", "value": "leaf" },
        { "text": "soilAnalyses.sampleType.grape", "value": "grape" }
      ]
    },
    { "type": "textbox", "name": "lab_name", "title": "soilAnalyses.labName", "width": "48%" },

    { "type": "number", "name": "ph", "title": "soilAnalyses.ph", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "organic_matter_pct", "title": "soilAnalyses.organicMatterPct", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "cec", "title": "soilAnalyses.cec", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "nitrogen", "title": "soilAnalyses.nitrogen", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "phosphorus", "title": "soilAnalyses.phosphorus", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "potassium", "title": "soilAnalyses.potassium", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "calcium", "title": "soilAnalyses.calcium", "width": "33.33%", "step": 0.01 },
    { "type": "number", "name": "magnesium", "title": "soilAnalyses.magnesium", "width": "33.33%", "step": 0.01 },

    { "type": "textarea", "name": "notes", "title": "general.notes", "width": "100%" }
  ]
}
